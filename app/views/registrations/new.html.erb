<div class="auth">
  <section class="auth__panel glass">
    <span class="auth__brand">Task List</span>
    <h1>Create an account</h1>

    <% if @user.errors.any? %>
      <div class="auth__alert" role="alert">
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_path, class: "auth__form" do |form| %>
      <label class="field">
        Email address
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
      </label>
      <label class="field">
        Password (8 or more characters)
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      </label>
      <label class="field">
        Confirm password
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </label>
      <%= form.submit "Create account", class: "button button--primary" %>
    <% end %>

    <%= link_to "Already have an account? Sign in", new_session_path %>
  </section>
</div>
